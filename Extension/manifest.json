{
  "manifest_version": 3,
  "name": "Internet Downloader Integration Module",
  "version": "1.1.0",
  "description": "Tích hợp tải xuống đa luồng siêu tốc, bắt link video/audio/ảnh và quét hàng loạt cho Internet Downloader trên macOS.",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles/sniffer.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
